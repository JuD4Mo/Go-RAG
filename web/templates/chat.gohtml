<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{.Title}}</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="https://cdn.tailwindcss.com?plugins=typography"></script>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify@3/dist/purify.min.js"></script>
<style>
  :root {
    color-scheme: dark;
    --bg:        #050505;
    --panel:     #0d0d0d;
    --panel-2:   #111111;
    --field:     #080808;
    --line:      #262626;
    --line-2:    #1a1a1a;
    --text:      #cfcfcf;
    --text-dim:  #8a8a8a;
    --muted:     #555555;
    --red:       #d90416;
    --red-dim:   #5c0d13;
    --red-deep:  #20060a;
    --font-mono: ui-monospace, "SF Mono", "Cascadia Code", "JetBrains Mono", Menlo, Consolas, "Liberation Mono", monospace;
    --font-sans: -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }

  html, body { height: 100%; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-mono);
    overflow: hidden;
  }

  /* ---- background layers: grain, scanlines, vignette ---- */
  body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: .045;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  }
  body::after {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      repeating-linear-gradient(0deg, rgba(255,255,255,0.015) 0 1px, transparent 1px 3px),
      radial-gradient(ellipse at center, transparent 58%, rgba(0,0,0,0.6) 100%);
  }

  ::selection { background: var(--red-dim); color: #fff; }

  .app-shell {
    position: relative;
    z-index: 1;
    height: 100%;
    max-width: 940px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    padding: 16px 18px;
  }

  /* ---- header / toolbar ---- */
  .toolbar {
    border: 1px solid var(--line);
    background: var(--panel);
    padding: 10px 14px 12px;
    flex-shrink: 0;
  }
  .toolbar-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    font-size: 11px;
    letter-spacing: .14em;
  }
  .toolbar-brand { color: var(--muted); }
  .toolbar-title { color: var(--text); text-transform: uppercase; }
  .tag {
    color: var(--text-dim);
    border: 1px solid var(--line-2);
    padding: 2px 7px;
    white-space: nowrap;
  }
  .tag-red { color: var(--red); border-color: var(--red-dim); }
  .toolbar-rule {
    height: 1px;
    background: var(--line-2);
    margin: 9px 0;
  }
  .toolbar-meta { justify-content: flex-start; font-size: 10px; letter-spacing: .12em; }
  .status {
    display: inline-flex;
    align-items: center;
    color: var(--muted);
    text-transform: uppercase;
  }
  .status + .status { margin-left: 18px; }
  .dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 7px;
    background: var(--red);
    box-shadow: 0 0 6px var(--red);
    animation: blink 1.8s steps(1) infinite;
  }

  /* ---- chat log ---- */
  #log {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    margin-top: 14px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-top: 2px solid var(--red-dim);
    padding: 16px;
    font-family: var(--font-mono);
    scrollbar-color: #222 var(--panel);
  }
  #log::-webkit-scrollbar { width: 8px; }
  #log::-webkit-scrollbar-track { background: var(--panel); }
  #log::-webkit-scrollbar-thumb { background: #222; border: 1px solid #000; }
  #log::-webkit-scrollbar-thumb:hover { background: var(--red-dim); }

  /* ---- messages ---- */
  .msg { display: flex; margin-bottom: 18px; }
  .msg--user { justify-content: flex-end; }
  .msg--assistant { justify-content: flex-start; }
  .msg-inner { max-width: 84%; min-width: 0; }
  .msg-meta {
    display: flex;
    gap: 10px;
    font-size: 10px;
    letter-spacing: .1em;
    color: var(--muted);
    margin-bottom: 5px;
  }
  .msg--user .msg-meta { justify-content: flex-end; }
  .msg-name--user { color: var(--red); }
  .msg-name--sys { color: var(--text-dim); }
  .msg-box {
    padding: 10px 12px;
    font-size: 13px;
    line-height: 1.55;
    color: var(--text);
    word-wrap: break-word;
    overflow-wrap: break-word;
  }
  .msg-box--user {
    background: var(--field);
    border: 1px solid var(--line-2);
    border-left: 3px solid var(--red);
    white-space: pre-wrap;
    font-size: 13px;
  }
  .msg-box--sys {
    background: var(--panel-2);
    border: 1px solid var(--line-2);
    border-left: 2px solid var(--line);
  }

  /* typing indicator */
  .msg-box--typing {
    background: var(--field);
    border: 1px solid var(--line-2);
    border-left: 2px solid var(--red-dim);
    color: var(--text-dim);
    font-size: 12px;
    letter-spacing: .12em;
  }
  .typing-cursor {
    display: inline-block;
    width: 8px;
    height: 13px;
    margin-left: 7px;
    vertical-align: middle;
    background: var(--red);
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink { 50% { opacity: 0; } }

  /* ---- markdown body ---- */
  .msg-body { font-family: var(--font-sans); font-size: 14px; line-height: 1.6; }
  .msg-body > :first-child { margin-top: 0; }
  .msg-body > :last-child { margin-bottom: 0; }
  .msg-body p { margin: .45em 0; }
  .msg-body h1, .msg-body h2, .msg-body h3, .msg-body h4 {
    font-family: var(--font-mono);
    margin: 1.1em 0 .45em;
    color: var(--text);
    text-transform: uppercase;
    letter-spacing: .06em;
  }
  .msg-body h1 { font-size: 15px; border-left: 3px solid var(--red); padding-left: 9px; }
  .msg-body h2 { font-size: 14px; border-left: 2px solid var(--red-dim); padding-left: 8px; }
  .msg-body h3, .msg-body h4 { font-size: 13px; }
  .msg-body code {
    font-family: var(--font-mono);
    font-size: 12px;
    background: #000;
    border: 1px solid var(--line-2);
    color: #e8e8e8;
    padding: 1px 5px;
  }
  .msg-body pre {
    background: #000;
    border: 1px solid var(--line-2);
    border-left: 3px solid var(--red-dim);
    padding: 10px 12px;
    margin: .6em 0;
    overflow-x: auto;
  }
  .msg-body pre code { background: transparent; border: 0; padding: 0; display: block; }
  .msg-body table { border-collapse: collapse; margin: .6em 0; width: 100%; font-size: 12px; font-family: var(--font-mono); }
  .msg-body th {
    border: 1px solid var(--line);
    background: #101010;
    color: var(--text);
    padding: 5px 9px;
    text-align: left;
    text-transform: uppercase;
    letter-spacing: .05em;
  }
  .msg-body td { border: 1px solid var(--line-2); padding: 5px 9px; }
  .msg-body blockquote {
    margin: .6em 0;
    padding: 2px 12px;
    border-left: 3px solid var(--red);
    color: var(--text-dim);
  }
  .msg-body a { color: var(--text-dim); text-decoration: underline; text-decoration-color: var(--red-dim); }
  .msg-body a:hover { color: var(--red); }
  .msg-body ul, .msg-body ol { margin: .45em 0; padding-left: 1.5em; }
  .msg-body li { margin: .15em 0; }
  .msg-body hr { border: 0; border-top: 1px solid var(--line); margin: .9em 0; }
  .msg-body strong { color: #fff; }
  .msg-body img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: .6em 0;
    border: 1px solid var(--line);
    background: #000;
  }

  /* ---- notices ---- */
  .notice-row { display: flex; justify-content: center; margin: 10px 0; }
  .notice {
    max-width: 90%;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--text-dim);
    background: #000;
    border: 1px solid var(--line-2);
    padding: 6px 12px;
  }
  .notice--ok { color: #9ab98f; background: #0a1208; border-color: #2c4027; }
  .notice--err { color: #e5484d; background: #140708; border-color: #4a1417; }

  /* ---- input terminal ---- */
  #form {
    display: flex;
    gap: 10px;
    margin-top: 14px;
    flex-shrink: 0;
  }
  .btn {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--text-dim);
    background: var(--panel);
    border: 1px solid var(--line);
    padding: 12px 14px;
    cursor: pointer;
    transition: color .12s ease, border-color .12s ease, background-color .12s ease;
  }
  .btn:hover { color: #fff; border-color: var(--red); }
  .btn:disabled { opacity: .35; cursor: wait; }
  .btn:disabled:hover { color: var(--text-dim); border-color: var(--line); }
  .btn-icon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 11px;
  }
  .btn-icon svg { width: 17px; height: 17px; }
  .btn-icon::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 9px);
    left: 50%;
    transform: translateX(-50%);
    background: #000;
    border: 1px solid var(--line);
    color: var(--text-dim);
    font-size: 10px;
    letter-spacing: .08em;
    text-transform: uppercase;
    white-space: nowrap;
    padding: 4px 8px;
    opacity: 0;
    pointer-events: none;
    transition: opacity .12s ease;
  }
  .btn-icon:hover::after { opacity: 1; }
  .btn-exec { color: #fff; background: var(--red-deep); border-color: var(--red); }
  .btn-exec:hover { background: var(--red); border-color: var(--red); }
  .btn:focus-visible, .btn-icon:focus-visible { outline: 1px solid var(--red); outline-offset: 2px; }

  .term {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
    min-width: 0;
    background: #000;
    border: 1px solid var(--line);
    padding: 0 12px;
    transition: border-color .12s ease;
  }
  .term:focus-within { border-color: var(--red); box-shadow: 0 0 0 1px var(--red-dim); }
  .term-prompt { color: var(--red); font-family: var(--font-mono); font-size: 14px; }
  #input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    outline: none;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 12px 0;
    caret-color: var(--red);
  }
  #input::placeholder { color: var(--muted); }

  /* ---- image dialog ---- */
  dialog#imageDialog {
    background: #000;
    color: var(--text);
    border: 1px solid var(--line);
    padding: 0;
    width: min(30rem, 92vw);
    max-width: 92vw;
  }
  dialog#imageDialog::backdrop { background: rgba(0,0,0,.72); }
  .image-win-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 14px;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .16em;
  }
  .image-win-header .accent { color: var(--red); }
  .image-form { padding: 16px; display: flex; flex-direction: column; gap: 16px; }
  .image-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .image-field {
    width: 100%;
    box-sizing: border-box;
    background: var(--field);
    border: 1px solid var(--line);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 9px 11px;
    outline: none;
    transition: border-color .12s ease;
  }
  .image-field:focus { border-color: var(--red); }
  textarea.image-field { resize: none; min-height: 90px; }
  .image-file::file-selector-button {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--text-dim);
    background: var(--panel);
    border: 1px solid var(--line);
    padding: 6px 10px;
    margin-right: 12px;
    cursor: pointer;
  }
  .image-file::file-selector-button:hover { color: #fff; border-color: var(--red); }
  .image-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 4px; }
  .image-caption-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; }

  @media (max-width: 560px) {
    .app-shell { padding: 10px 10px; }
    .toolbar-row { letter-spacing: .1em; }
    .toolbar-title { font-size: 10px; }
    .status + .status { margin-left: 12px; }
    .msg-inner { max-width: 92%; }
    #form { flex-wrap: wrap; }
    .term { flex: 1 1 100%; order: 3; }
    .btn-icon { order: 1; }
    #send { order: 2; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
</head>
<body>
  <div class="app-shell">

    <header class="toolbar" role="banner">
      <div class="toolbar-row">
        <span class="tag tag-red" aria-hidden="true">STATUS</span>
        <span class="toolbar-brand">SYSTEM //</span>
        <span class="toolbar-title">{{.Title}}</span>
        <span class="tag" aria-hidden="true">TERM 0</span>
      </div>
      <div class="toolbar-rule" aria-hidden="true"></div>
      <div class="toolbar-row toolbar-meta">
        <span class="status"><span class="dot" aria-hidden="true"></span>ONLINE</span>
        <span class="status"><span class="dot" aria-hidden="true"></span>SESSION ACTIVE</span>
        <span class="status"><span class="dot" aria-hidden="true"></span>SECURE CHANNEL</span>
      </div>
    </header>

    <div id="log" role="log" aria-live="polite"></div>

    <form id="form">
      <input type="file" id="file" accept=".txt,.md,.markdown,text/plain,text/markdown" hidden>
      <button
        type="button"
        id="attach"
        class="btn btn-icon"
        data-tip="Attach file"
        aria-label="Attach a .txt or .md file to the document collection"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21.44 11.05 12.25 20.24a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
        </svg>
      </button>
      <button
        type="button"
        id="attachImage"
        class="btn btn-icon"
        data-tip="Attach image"
        aria-label="Upload an image with a description"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="1" ry="1"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <polyline points="21 15 16 10 5 21"/>
        </svg>
      </button>

      <div class="term">
        <span class="term-prompt" aria-hidden="true">&gt;</span>
        <input
          type="text"
          id="input"
          autocomplete="off"
          placeholder="ask something…"
          autofocus
          aria-label="Message"
        >
      </div>

      <button type="submit" id="send" class="btn btn-exec">[ EXEC ]</button>
    </form>
  </div>

  <dialog id="imageDialog" aria-labelledby="imageDialogTitle">
    <div class="image-win-header">
      <span class="accent" aria-hidden="true">▌</span>
      <span id="imageDialogTitle">IMAGE INGESTION</span>
    </div>
    <form id="imageForm" class="image-form">
      <div>
        <label class="image-label" for="imageFile">File</label>
        <input
          type="file"
          id="imageFile"
          accept=".png,.jpg,.jpeg,.webp,.gif,image/png,image/jpeg,image/webp,image/gif"
          required
          class="image-field image-file"
        >
      </div>
      <div>
        <div class="image-caption-row">
          <label class="image-label" for="imageDescription" style="margin-bottom:0">Description</label>
          {{if .CaptionEnabled}}
          <button
            type="button"
            id="autoCaption"
            class="btn"
            title="Generate a description from the image using the vision model"
            style="padding:5px 9px;font-size:10px"
          >AUTO-CAPTION</button>
          {{end}}
        </div>
        <textarea
          id="imageDescription"
          rows="4"
          required
          placeholder="Describe what's in the image so it can be retrieved later."
          class="image-field"
          style="margin-top:6px"
        ></textarea>
      </div>
      <div class="image-actions">
        <button type="button" id="imageCancel" class="btn">[ CANCEL ]</button>
        <button type="submit" id="imageSubmit" class="btn btn-exec">[ SAVE ]</button>
      </div>
    </form>
  </dialog>

<script>
  const log = document.getElementById("log");
  const form = document.getElementById("form");
  const input = document.getElementById("input");
  const send = document.getElementById("send");
  const attach = document.getElementById("attach");
  const fileInput = document.getElementById("file");
  const attachImage = document.getElementById("attachImage");
  const imageDialog = document.getElementById("imageDialog");
  const imageForm = document.getElementById("imageForm");
  const imageFile = document.getElementById("imageFile");
  const imageDescription = document.getElementById("imageDescription");
  const imageCancel = document.getElementById("imageCancel");
  const imageSubmit = document.getElementById("imageSubmit");
  const history = [];

  // Render a centered system notice — used for upload status and other
  // out-of-band events that aren't part of the chat history. Returns the
  // inner text node so callers can update its content (e.g.
  // "[UPLOAD] …" → "[OK] DOCUMENT ADDED").
  function renderNotice(text, tone = "info") {
    const palette = {
      info:    "notice",
      success: "notice notice--ok",
      error:   "notice notice--err",
    };
    const row = document.createElement("div");
    row.className = "notice-row";
    const note = document.createElement("div");
    note.className = palette[tone] || palette.info;
    note.textContent = text;
    row.appendChild(note);
    log.appendChild(row);
    log.scrollTop = log.scrollHeight;
    return note;
  }

  // Configure marked once. GFM is on for tables/strikethrough; breaks
  // turns single newlines into <br> so chat-style replies render the
  // way users typed them.
  marked.setOptions({ gfm: true, breaks: true });

  // Render untrusted markdown from the model into sanitized HTML.
  // DOMPurify drops scripts, event handlers, and other XSS vectors
  // before the result is inserted into the DOM.
  function renderMarkdown(text) {
    return DOMPurify.sanitize(marked.parse(text || ""));
  }

  function clock() {
    return new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", second: "2-digit" });
  }

  // Render a chat message for the given role and return the inner
  // node that streaming callers should keep updating. User messages
  // stay as plain text (we trust the user, but they didn't ask for
  // markdown either); assistant messages render as sanitized
  // markdown via setMarkdown().
  function render(role, content) {
    const isUser = role === "user";

    const row = document.createElement("div");
    row.className = "msg msg--" + (isUser ? "user" : "assistant");

    const inner = document.createElement("div");
    inner.className = "msg-inner";

    const meta = document.createElement("div");
    meta.className = "msg-meta";
    const name = document.createElement("span");
    name.className = isUser ? "msg-name msg-name--user" : "msg-name msg-name--sys";
    name.textContent = isUser ? "USER //" : "SYSTEM //";
    const time = document.createElement("span");
    time.className = "msg-time";
    time.textContent = clock();
    meta.appendChild(name);
    meta.appendChild(time);

    const bubble = document.createElement("div");
    bubble.className = isUser ? "msg-box msg-box--user" : "msg-box msg-box--sys msg-body";
    if (isUser) {
      bubble.textContent = content;
    } else {
      bubble.innerHTML = renderMarkdown(content);
    }
    // Helper attached to the bubble so callers don't have to know
    // which role it is — they just push text in.
    bubble.setMarkdown = (text) => {
      if (isUser) bubble.textContent = text;
      else bubble.innerHTML = renderMarkdown(text);
    };

    inner.appendChild(meta);
    inner.appendChild(bubble);
    row.appendChild(inner);
    log.appendChild(row);
    log.scrollTop = log.scrollHeight;
    return bubble;
  }

  // Terminal-style indicator shown while we wait for the first token.
  function renderTyping() {
    const row = document.createElement("div");
    row.className = "msg msg--assistant";

    const inner = document.createElement("div");
    inner.className = "msg-inner";

    const meta = document.createElement("div");
    meta.className = "msg-meta";
    const name = document.createElement("span");
    name.className = "msg-name msg-name--sys";
    name.textContent = "SYSTEM //";
    const time = document.createElement("span");
    time.className = "msg-time";
    time.textContent = clock();
    meta.appendChild(name);
    meta.appendChild(time);

    const bubble = document.createElement("div");
    bubble.className = "msg-box msg-box--typing";
    const label = document.createElement("span");
    label.textContent = "PROCESSING";
    const cursor = document.createElement("span");
    cursor.className = "typing-cursor";
    cursor.setAttribute("aria-hidden", "true");
    bubble.appendChild(label);
    bubble.appendChild(cursor);

    inner.appendChild(meta);
    inner.appendChild(bubble);
    row.appendChild(inner);
    log.appendChild(row);
    log.scrollTop = log.scrollHeight;
    return { row, bubble };
  }

  attach.addEventListener("click", () => fileInput.click());

  // Image upload — opens a small dialog so the user can pick an image
  // and write a description in one step. The description is what gets
  // embedded; the image itself is just stored for later display.
  attachImage.addEventListener("click", () => {
    imageForm.reset();
    imageDialog.showModal();
    imageDescription.focus();
  });
  imageCancel.addEventListener("click", () => imageDialog.close());

  // Auto-caption — only present when the server has a VISION_MODEL
  // configured. Sends the chosen image to /api/caption and pre-fills
  // the description textarea with the model's reply. The user reviews
  // and edits before saving, so a hallucinated caption never makes it
  // into the vector store unchanged.
  const autoCaption = document.getElementById("autoCaption");
  if (autoCaption) {
    autoCaption.addEventListener("click", async () => {
      const file = imageFile.files && imageFile.files[0];
      if (!file) {
        imageFile.focus();
        return;
      }
      const original = autoCaption.textContent;
      autoCaption.disabled = true;
      autoCaption.textContent = "captioning…";
      try {
        const body = new FormData();
        body.append("image", file);
        const res = await fetch("/api/caption", { method: "POST", body });
        if (!res.ok) {
          const err = (await res.text()).trim();
          alert("Caption failed: " + (err || res.statusText));
          return;
        }
        const data = await res.json();
        imageDescription.value = data.description || "";
        imageDescription.focus();
      } catch (err) {
        alert("Caption failed: " + err);
      } finally {
        autoCaption.disabled = false;
        autoCaption.textContent = original;
      }
    });
  }

  imageForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const file = imageFile.files && imageFile.files[0];
    const description = imageDescription.value.trim();
    if (!file || !description) return;

    imageSubmit.disabled = true;
    const notice = renderNotice(`[UPLOAD] ${file.name}…`, "info");

    try {
      const body = new FormData();
      body.append("image", file);
      body.append("description", description);

      const res = await fetch("/api/upload/image", { method: "POST", body });

      if (!res.ok) {
        const err = (await res.text()).trim();
        notice.textContent = `[ERROR] ${file.name}: ${err || res.statusText}`;
        notice.parentElement.querySelector("div").className = "notice notice--err";
        return;
      }
      const data = await res.json();
      notice.textContent =
        `[OK] IMAGE ADDED — ${data.source} · ${data.chunks} CHUNK${data.chunks === 1 ? "" : "S"} · ${data.bytes} BYTES`;
      notice.parentElement.querySelector("div").className = "notice notice--ok";
      imageDialog.close();
    } catch (err) {
      notice.textContent = `[ERROR] ${file.name}: ${err}`;
      notice.parentElement.querySelector("div").className = "notice notice--err";
    } finally {
      imageSubmit.disabled = false;
      input.focus();
    }
  });

  fileInput.addEventListener("change", async () => {
    const file = fileInput.files && fileInput.files[0];
    if (!file) return;
    // Reset so picking the same file twice still fires "change".
    fileInput.value = "";

    const notice = renderNotice(`[UPLOAD] ${file.name}…`, "info");
    attach.disabled = true;
    send.disabled = true;

    try {
      const body = new FormData();
      body.append("file", file);

      const res = await fetch("/api/upload", { method: "POST", body });

      if (!res.ok) {
        const err = (await res.text()).trim();
        notice.textContent = `[ERROR] ${file.name}: ${err || res.statusText}`;
        notice.parentElement.querySelector("div").className = "notice notice--err";
        return;
      }
      const data = await res.json();
      notice.textContent =
        `[OK] DOCUMENT ADDED — ${data.source} · ${data.chunks} CHUNK${data.chunks === 1 ? "" : "S"} · ${data.bytes} BYTES`;
      notice.parentElement.querySelector("div").className = "notice notice--ok";
    } catch (err) {
      notice.textContent = `[ERROR] ${file.name}: ${err}`;
      notice.parentElement.querySelector("div").className = "notice notice--err";
    } finally {
      attach.disabled = false;
      send.disabled = false;
      input.focus();
    }
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const text = input.value.trim();
    if (!text) return;
    input.value = "";
    send.disabled = true;

    history.push({ role: "user", content: text });
    render("user", text);
    const typing = renderTyping();
    let pending = null;

    function ensureBubble() {
      if (pending) return pending;
      typing.row.remove();
      pending = render("assistant", "");
      return pending;
    }

    try {
      const res = await fetch("/api/chat/stream", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ messages: history }),
      });
      if (!res.ok || !res.body) {
        const err = await res.text();
        ensureBubble().setMarkdown("error: " + err);
        history.pop();
        return;
      }

      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let buffer = "";
      let assembled = "";
      let errored = null;

      // SSE events are delimited by a blank line ("\n\n"). Each event
      // is one or more "field: value" lines; here we only care about
      // the "event:" type and the "data:" payload (JSON-encoded
      // string).
      while (true) {
        const { value, done } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });

        let sep;
        while ((sep = buffer.indexOf("\n\n")) !== -1) {
          const raw = buffer.slice(0, sep);
          buffer = buffer.slice(sep + 2);

          let evt = "message", data = "";
          for (const line of raw.split("\n")) {
            if (line.startsWith("event:")) evt = line.slice(6).trim();
            else if (line.startsWith("data:")) data += line.slice(5).trim();
          }
          let payload = "";
          try { payload = JSON.parse(data); } catch { payload = data; }

          if (evt === "delta") {
            assembled += payload;
            ensureBubble().setMarkdown(assembled);
            log.scrollTop = log.scrollHeight;
          } else if (evt === "error") {
            errored = payload || "stream error";
          }
        }
      }

      if (errored) {
        ensureBubble().setMarkdown("error: " + errored);
        history.pop();
      } else if (assembled) {
        history.push({ role: "assistant", content: assembled });
      } else {
        ensureBubble().setMarkdown("(no response)");
        history.pop();
      }
    } catch (err) {
      ensureBubble().setMarkdown("error: " + err);
      history.pop();
    } finally {
      // If the typing indicator is still on screen (e.g. fetch threw
      // before any event), drop it so the UI doesn't get stuck.
      if (typing.row.isConnected) typing.row.remove();
      send.disabled = false;
      input.focus();
    }
  });
</script>
</body>
</html>
